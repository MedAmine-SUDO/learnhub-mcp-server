# Base URL of the LMS API (the bundled mock runs on :8000)
LEARNHUB_API_BASE_URL=http://127.0.0.1:8000

# Tenant registry: a local JSON file, or s3://bucket/key
LEARNHUB_TENANT_REGISTRY=tenants.example.json

# Client token for the local stdio transport (Lambda reads it from the request header)
LEARNHUB_CLIENT_TOKEN=demo-token-acme

LEARNHUB_RATE_LIMIT_PER_MINUTE=300
LEARNHUB_RESULT_STORE_DIR=.results
LEARNHUB_INLINE_MAX_ITEMS=25

# For an s3:// registry against Floci (local AWS emulator) instead of real AWS:
# AWS_ENDPOINT_URL=http://localhost:4566
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test
# AWS_DEFAULT_REGION=us-east-1
